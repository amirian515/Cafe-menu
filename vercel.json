{
  "services": {
    "frontend": {
      "root": "./",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "./backend",
      "framework": "express",
      "buildCommand": "npm install",
      "outputDirectory": "."
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ]
}