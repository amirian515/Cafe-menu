 {
  "services": [
    {
      "name": "frontend",
      "root": "./",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    {
      "name": "backend",
      "root": "./backend",
      "framework": "express",
      "buildCommand": "npm install",
      "outputDirectory": "."
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}